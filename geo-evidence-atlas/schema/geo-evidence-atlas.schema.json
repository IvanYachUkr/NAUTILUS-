{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/geo-evidence-atlas.schema.json",
  "title": "Geo Evidence Atlas case collection",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/case"
  },
  "$defs": {
    "coordinate": {
      "type": "object",
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "streetView": {
      "type": "object",
      "required": [
        "viewpoint"
      ],
      "properties": {
        "viewpoint": {
          "$ref": "#/$defs/coordinate"
        },
        "panoId": {
          "type": "string"
        },
        "heading": {
          "type": "number"
        },
        "pitch": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "fov": {
          "type": "number",
          "minimum": 10,
          "maximum": 100
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "ratings": {
      "type": "object",
      "properties": {
        "visible": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "correct": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "useful": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "consistent": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "cue": {
      "type": "object",
      "required": [
        "text",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "starting-image",
            "panorama",
            "map"
          ]
        },
        "ratings": {
          "$ref": "#/$defs/ratings"
        },
        "evidenceView": {
          "$ref": "#/$defs/streetView"
        }
      },
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "model",
        "condition",
        "hypothesis",
        "cues"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "enum": [
            "static-image",
            "interactive-panorama"
          ]
        },
        "prediction": {
          "anyOf": [
            {
              "$ref": "#/$defs/coordinate"
            },
            {
              "type": "null"
            }
          ]
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "durationSeconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "accuracy": {
          "type": "object",
          "properties": {
            "country": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "region": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "cues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cue"
          }
        },
        "notes": {
          "type": "string"
        },
        "isMock": {
          "type": "boolean"
        },
        "exploration": {
          "$ref": "#/$defs/exploration"
        },
        "runStatus": {
          "enum": [
            "complete",
            "recording-only"
          ]
        }
      },
      "additionalProperties": true
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "title",
        "city",
        "country",
        "difficulty",
        "summary",
        "groundTruth",
        "startingView",
        "runs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "landmark": {
          "type": "string"
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "minLength": 1
        },
        "countryCode": {
          "type": "string"
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "sceneType": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sceneImageUrl": {
          "type": "string"
        },
        "sceneImageAlt": {
          "type": "string"
        },
        "visual": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "accent": {
              "type": "string"
            },
            "motif": {
              "enum": [
                "tower",
                "arches",
                "columns",
                "spires",
                "bridge",
                "grid"
              ]
            }
          },
          "additionalProperties": true
        },
        "groundTruth": {
          "$ref": "#/$defs/coordinate"
        },
        "startingView": {
          "$ref": "#/$defs/streetView"
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/run"
          }
        }
      },
      "additionalProperties": true
    },
    "explorationPoint": {
      "type": "object",
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "tMs": {
          "type": "number",
          "minimum": 0
        },
        "heading": {
          "type": [
            "number",
            "null"
          ]
        },
        "pitch": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "zoom": {
          "type": [
            "number",
            "null"
          ]
        },
        "panoId": {
          "type": [
            "string",
            "null"
          ]
        },
        "seq": {
          "type": "number"
        },
        "source": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "fov": {
          "type": [
            "number",
            "null"
          ]
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "exploration": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/explorationPoint"
          }
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "startedAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "stoppedAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "durationMs": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "sampleCount": {
              "type": "integer",
              "minimum": 0
            },
            "pointCount": {
              "type": "integer",
              "minimum": 0
            },
            "path": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/explorationPoint"
              }
            },
            "samples": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/explorationPoint"
              }
            },
            "recorder": {
              "type": "object"
            },
            "keyMoments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/keyMoment"
              }
            },
            "captureSources": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "path"
              ]
            },
            {
              "required": [
                "samples"
              ]
            }
          ],
          "additionalProperties": true
        }
      ]
    },
    "keyMoment": {
      "type": "object",
      "required": [
        "label",
        "tMs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tMs": {
          "type": "number",
          "minimum": 0
        },
        "sampleIndex": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  }
}
