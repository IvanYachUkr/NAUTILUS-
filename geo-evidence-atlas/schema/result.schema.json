{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/geo-evidence-atlas/result.schema.json",
  "title": "Location model results",
  "type": "object",
  "required": ["schemaVersion", "locationId", "runs"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "locationId": { "type": "string", "minLength": 1 },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "model", "condition", "prediction", "hypothesis", "cues"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "condition": { "enum": ["static-image", "interactive-panorama"] },
          "recordingId": { "type": "string" },
          "prediction": {
            "type": "object",
            "required": ["lat", "lng"],
            "properties": {
              "lat": { "type": "number", "minimum": -90, "maximum": 90 },
              "lng": { "type": "number", "minimum": -180, "maximum": 180 },
              "label": { "type": "string" }
            }
          },
          "hypothesis": { "type": "string", "minLength": 1 },
          "cues": { "type": "array" }
        }
      }
    }
  }
}
