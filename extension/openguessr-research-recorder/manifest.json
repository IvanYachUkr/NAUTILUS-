{
  "manifest_version": 3,
  "name": "OpenGuessr Research Round Recorder",
  "description": "Explicitly armed OpenGuessr competition recorder with per-round JSON capture, prediction pins, NMPZ support, and in-page recording status.",
  "version": "0.6.7",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://openguessr.com/*",
    "https://www.openguessr.com/*",
    "https://*.google.com/maps/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "OpenGuessr Research Recorder",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://openguessr.com/*",
        "https://www.openguessr.com/*"
      ],
      "js": [
        "page/openguessr-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://openguessr.com/*",
        "https://www.openguessr.com/*"
      ],
      "js": [
        "content/openguessr-relay.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://*.google.com/maps/*"
      ],
      "js": [
        "page/google-streetview-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.google.com/maps/*"
      ],
      "js": [
        "content/google-relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
